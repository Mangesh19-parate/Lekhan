# Environment: dev, staging, prod
ENV=dev

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://lekhan:lekhan@localhost:5432/lekhan_dev

# Cryptographic Keys
# For SECRET_KEY (min 32 bytes): python -c "import secrets; print(secrets.token_urlsafe(48))"
# For MASTER_KEY & INDEX_KEY (must be 32 bytes base64): python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SECRET_KEY=change-me-session-secret-at-least-48-chars
MASTER_KEY=change-me-base64-32bytes-for-field-encryption
INDEX_KEY=change-me-base64-32bytes-for-blind-indexing

# Storage and External Tools
STORAGE_PATH=./var/storage
SOFFICE_BIN=soffice

# CORS and Session Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

