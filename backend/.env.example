# Environment: dev, staging, prod
ENV=dev

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://lekhan:lekhan@localhost:5432/lekhan_dev

# Cryptographic Keys (generate with: python -c "import secrets, base64; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-session-secret-at-least-48-chars
MASTER_KEY=change-me-base64-32bytes-for-field-encryption
INDEX_KEY=change-me-base64-32bytes-for-blind-indexing

# Storage and External Tools
STORAGE_PATH=./var/storage
SOFFICE_BIN=soffice

# CORS and Session Configuration
ALLOWED_ORIGINS=http://localhost:5173
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

