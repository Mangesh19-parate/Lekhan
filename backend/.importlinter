[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:domain-isolation]
name = Domain layer must not import FastAPI or SQLAlchemy
type = forbidden
source_modules =
    app.lang_packs
    app.units
    app.templates
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    app.adapters
ignore_imports =
    app.templates.registry -> app.adapters.storage
    app.templates.registry -> app.audit.service
    app.templates.registry -> app.shared.errors
    app.lang_packs.base -> app.shared.errors
    app.units.stamp_duty -> app.adapters.db
    app.units.stamp_duty -> app.shared.models
    app.units.stamp_duty -> sqlalchemy

[importlinter:contract:layers]
name = Architectural layer boundaries
type = layers
layers =
    app.main
    app.shared.middleware
    app.adapters
    app.shared.models
    app.shared.ids
