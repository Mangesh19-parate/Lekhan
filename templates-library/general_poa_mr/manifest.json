      "label_mr": "मुखत्यारपत्र लिहून देणारे"
    },
    "attorneys": {
      "role": "attorney",
      "min_parties": 1,
      "max_parties": 2,
      "label_en": "Appointed Attorney(s) / मुखत्यार",
      "label_mr": "नेमलेले मुखत्यार"
    }
  },
  "repeaters": {
