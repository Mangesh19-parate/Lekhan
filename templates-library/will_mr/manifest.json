        "property.mouza",
        "property.khasra_no",
        "property.area_sqm"
      ]
    }
  ],
  "fields": {
    "execution_date": {
      "name": "execution_date",
      "type": "string",
      "label_en": "Execution Date",
      "label_mr": "दस्त नोंदणी दिनांक",
      "required": true
    },
    "property.mouza": {
      "name": "property.mouza",
      "type": "string",
      "label_en": "Mouza / Village",
      "label_mr": "मौजे",
      "required": true
    },
    "property.khasra_no": {
      "name": "property.khasra_no",
      "type": "string",
      "label_en": "Khasra / Survey No.",
      "label_mr": "खसरा / सर्व्हे क्र.",
      "required": true
    },
    "property.area_sqm": {
      "name": "property.area_sqm",
      "type": "decimal",
      "label_en": "Area (Sq. Metres)",
      "label_mr": "क्षेत्रफळ (चौ.मी.)",
      "required": true
    }
