  "version": 1,
  "status": "draft",
  "document_type": "will",
  "property_type": "residential",
  "language": "mr",
  "page_size": "legal",
  "digits_setting": "western",
  "retention_class": "matter_lifecycle",
  "parties": {
    "testators": {
      "role": "testator",
      "min_parties": 1,
      "max_parties": 4,
      "label_en": "Testator(s)",
      "label_mr": "इच्छापत्र / मृत्युपत्र करणारे (चाचणीकार)"
    },
    "beneficiaries": {
      "role": "beneficiary",
      "min_parties": 1,
      "max_parties": 4,
      "label_en": "Beneficiary(ies)",
      "label_mr": "वारसदार / लाभार्थी"
    }
  },
  "repeaters": {
    "witnesses": {
      "name": "witnesses",
      "min": 2,
      "max": 2,
      "label_en": "Attesting Witnesses",
      "label_mr": "साक्षीदार"
    }
  },
  "sections": [
    {
      "id": "property_schedule",
      "title_en": "Property Schedule",
      "title_mr": "मिळकतीचे वर्णन",
